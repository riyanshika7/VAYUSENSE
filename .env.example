# VayuSense Environment Configuration

# WAQI (World Air Quality Index) API Token
# Obtain a free token from: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_api_token_here

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=30.0

# WAQI API Base URL
WAQI_BASE_URL=https://api.waqi.info

# Upstream request timeout in seconds
WAQI_REQUEST_TIMEOUT=10.0

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Application Settings
APP_NAME=VayuSense AQI Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
